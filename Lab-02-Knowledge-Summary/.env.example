# Copilot SDK 认证：Fine-grained PAT，权限 Account → Copilot Requests（Read）。
# 在 Codespace 里运行 bash .devcontainer/set-key.sh 会自动写好这个文件。
COPILOT_GITHUB_TOKEN=github_pat_your_token_here

# 对外 API 的访问密钥（Lab-03 给 Copilot Studio 用，请求头 x-api-key）。留空则不校验，仅限本机调试。
LAB_API_KEY=

# 可选：对外链接的根地址。Codespace 里会自动拼成 https://<codespace>-3000.app.github.dev，一般不用填。
PUBLIC_BASE_URL=
